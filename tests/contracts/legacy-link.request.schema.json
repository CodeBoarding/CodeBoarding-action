{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeboarding.org/schemas/licensing/v1/legacy-link.request.schema.json",
  "title": "Body of POST /legacy/link: the extension hands over the license key it had stored; the plan page confirms the license /me offered (offers.legacy_link)",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "license_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "license_key"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "via": {
          "enum": [
            "email"
          ]
        }
      },
      "required": [
        "via"
      ],
      "additionalProperties": false
    }
  ]
}
